{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "globals": {
    "afterEach": "readonly",
    "beforeEach": "readonly",
    "describe": "readonly",
    "expect": "readonly",
    "it": "readonly",
    "vi": "readonly"
  },
  "ignorePatterns": ["node_modules/", "out/", "dist/", ".vite/"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "settings": {
    "import/ignore": ["\\.d\\.ts$", "^vitest$", "^@testing-library/"],
    "import/resolver": {
      "typescript": {
        "extensions": [".ts", ".tsx", ".js", ".jsx"]
      }
    }
  }
}
