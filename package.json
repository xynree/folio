    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "40.7.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "typescript": "~4.5.4",
    "vite": "^5.4.21",
    "vitest": "^4.1.9"
